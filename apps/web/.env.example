# apps/web. Copy to .env.local (Next.js loads it automatically). Never commit real values.

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgres://seenit:seenit@localhost:5432/seenit

# Robinhood Chain (official docs: https://docs.robinhood.com/chain/connecting)
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
RPC_URL=https://rpc.testnet.chain.robinhood.com

# Reward stablecoin. Take the address from the official Robinhood Chain docs.
NEXT_PUBLIC_REWARD_TOKEN_ADDRESS=
NEXT_PUBLIC_REWARD_TOKEN_SYMBOL=USDG
NEXT_PUBLIC_REWARD_TOKEN_DECIMALS=6

# Deployed contracts (see packages/contracts)
NEXT_PUBLIC_MISSION_ESCROW_ADDRESS=
NEXT_PUBLIC_PERSONHOOD_REGISTRY_ADDRESS=

# Backend signer keys (server only, never NEXT_PUBLIC_). Use a KMS in production.
OPERATOR_PRIVATE_KEY=
ATTESTER_PRIVATE_KEY=

# Media storage (Cloudflare R2, S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=seenit-media

# Proof of personhood (check provider docs before wiring up)
HUMAN_PASSPORT_API_KEY=
HUMAN_PASSPORT_SCORER_ID=
SELF_SCOPE=
