# apps/web. Copy to .env.local (Next.js loads it automatically). Never commit real values.
# Variables without NEXT_PUBLIC_ stay on the server.

# --- Database (matches docker-compose.yml defaults) ---------------------------
DATABASE_URL=postgres://seenit:seenit@localhost:5432/seenit
LOG_LEVEL=info

# --- Robinhood Chain (official docs: https://docs.robinhood.com/chain/connecting)
CHAIN_ID=46630
RPC_URL=https://rpc.testnet.chain.robinhood.com
# From packages/contracts/deployments/<chainId>.json (or packages/shared deployments.ts)
MISSION_ESCROW_ADDRESS=
PERSONHOOD_REGISTRY_ADDRESS=
# Official stablecoin address from the Robinhood Chain docs. Do not guess it.
REWARD_TOKEN_ADDRESS=
# Must match MissionEscrow.tier1MaxReward (token base units).
TIER1_MAX_REWARD=5000000
# Block the indexer starts from on first run (the escrow deployment block).
INDEXER_START_BLOCK=0

# Backend signer with OPERATOR_ROLE on MissionEscrow (records / accepts / rejects).
# Use a dedicated low-balance key; prefer a KMS-backed signer in production.
OPERATOR_PRIVATE_KEY=

# --- Proof of personhood -----------------------------------------------------
# A provider is offered only when its settings below are complete.
# Backend signer with ATTESTER_ROLE on PersonhoodRegistry (writes tier attestations).
ATTESTER_PRIVATE_KEY=
REWARD_TOKEN_SYMBOL=USDG
REWARD_TOKEN_DECIMALS=6

# Tier 1: Human Passport (https://passport.human.tech) Stamps API v2.
# API key and Scorer ID come from the Human Passport developer portal.
HUMAN_PASSPORT_API_URL=https://api.passport.xyz
HUMAN_PASSPORT_API_KEY=
HUMAN_PASSPORT_SCORER_ID=
# Minimum Unique Humanity Score for Tier 1 (Passport recommends 20).
HUMAN_PASSPORT_MIN_SCORE=20
HUMAN_PASSPORT_TTL_DAYS=90

# Tier 2: Self Protocol (https://self.xyz).
SELF_APP_NAME=Seenit
# App scope, max 31 ASCII characters. Changing it changes every user's nullifier.
SELF_SCOPE=
# Public https URL the Self app posts proofs to (localhost is not allowed by Self).
SELF_ENDPOINT=https://your-domain.example/api/personhood/self/callback
# true = Self staging hub with mock passports (testnet / development only).
SELF_MOCK_PASSPORT=true
# Deep link the Self app returns to after proving.
SELF_DEEPLINK_CALLBACK=seenit://personhood
SELF_TTL_DAYS=365

# --- Media storage (Cloudflare R2, S3-compatible) ------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=seenit-media

# --- Auth ------------------------------------------------------------------------
# Host that Sign-In with Ethereum messages must name.
SIWE_DOMAIN=localhost:3000
# Bearer token for /api/cron/* (at least 32 characters).
CRON_SECRET=

# --- Public (shipped to the browser) ------------------------------------------
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
