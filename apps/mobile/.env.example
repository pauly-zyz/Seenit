# apps/mobile. Copy to .env (Expo loads it). Only EXPO_PUBLIC_* vars reach the app bundle,
# and anything in the bundle is public: never put secrets here.

# Seenit backend (apps/web). Use your machine's LAN IP when testing on a device.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Robinhood Chain (official docs: https://docs.robinhood.com/chain/connecting)
EXPO_PUBLIC_CHAIN_ID=46630
