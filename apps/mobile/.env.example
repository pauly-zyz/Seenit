# apps/mobile. Copy to .env (Expo loads it). Only EXPO_PUBLIC_* vars reach the app bundle,
# and anything in the bundle is public: never put secrets here.

# Seenit backend (apps/web). Use your machine's LAN IP when testing on a device.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Robinhood Chain (official docs: https://docs.robinhood.com/chain/connecting)
EXPO_PUBLIC_CHAIN_ID=46630
EXPO_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com
EXPO_PUBLIC_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
EXPO_PUBLIC_REWARD_TOKEN_SYMBOL=USDG
EXPO_PUBLIC_REWARD_TOKEN_DECIMALS=6

# WalletConnect / Reown project id (https://dashboard.reown.com). Public identifier, not a secret.
EXPO_PUBLIC_REOWN_PROJECT_ID=

# Google Maps keys (used at build time by the react-native-maps config plugin; restrict them to
# the app's package / bundle id in Google Cloud). Not needed for Apple Maps on iOS dev builds.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
