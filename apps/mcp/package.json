{
  "name": "@seenit/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server that lets AI agents create and track Seenit missions.",
  "bin": {
    "seenit-mcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@seenit/eslint-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
