{
  "name": "@seenit/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server that lets AI agents create and track Seenit missions.",
  "bin": {
    "seenit-mcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start:http": "node --env-file-if-exists=.env dist/index.js --http",
    "dev:http": "tsx watch --clear-screen=false src/index.ts --http"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "viem": "^2.57.7",
    "zod": "catalog:",
    "seenit-sdk": "workspace:*",
    "@seenit/shared": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@seenit/eslint-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
