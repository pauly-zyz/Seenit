# apps/mcp. Copy to .env. Never commit real values.

# Seenit backend the MCP server talks to (apps/web).
SEENIT_API_URL=http://localhost:3000
# API key issued to the agent / funder account (sk_...).
SEENIT_API_KEY=

# --- Optional: let this server sign funding / cancel transactions -----------------
# Without a key, confirm_mission and cancel_mission return the transactions for the user to sign
# in their own wallet. With a key, they sign after the user approves (client prompt, or explicit
# user_confirmed). Use a dedicated wallet that holds only what agents may spend.
SEENIT_FUNDER_PRIVATE_KEY=
# RPC for that wallet. Default: the chain's public RPC from the official Robinhood Chain docs.
SEENIT_RPC_URL=
# Max escrow per mission this server will fund, in token units (e.g. 50 = 50 USDG).
SEENIT_MAX_SPEND=50

# --- Streamable HTTP transport (seenit-mcp --http) ---------------------------------
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8787
# Bearer token clients must send. Required when MCP_HTTP_HOST is not localhost.
MCP_HTTP_TOKEN=
# Comma-separated hostnames accepted in Host/Origin when not on localhost (e.g. mcp.example.com).
MCP_HTTP_ALLOWED_HOSTS=
