# packages/contracts. Foundry loads .env from this folder. Never commit real values.

# --- Robinhood Chain ---------------------------------------------------------
# Official docs: https://docs.robinhood.com/chain/connecting
# Testnet chain ID is 46630. The public RPC is rate-limited; prefer a provider RPC.
RPC_URL=https://rpc.testnet.chain.robinhood.com

# Reward stablecoin (ERC-20). Take the address from the official Robinhood Chain docs
# for the network you deploy to. Do not guess it.
REWARD_TOKEN_ADDRESS=

# --- Roles -------------------------------------------------------------------
# Deploy with a Foundry keystore (`--account <name>`), not a raw private key.
# Admin of both contracts (multisig recommended outside testnet).
ADMIN_ADDRESS=
# Delay before an admin transfer can be accepted (seconds). Default 2 days.
ADMIN_TRANSFER_DELAY=172800
# Backend signer that writes personhood attestations.
ATTESTER_ADDRESS=
# Backend signer that records and resolves mission submissions.
OPERATOR_ADDRESS=
# Can pause new activity in an emergency. Defaults to ADMIN_ADDRESS.
PAUSER_ADDRESS=

# --- Economics ---------------------------------------------------------------
# Receives platform fees.
TREASURY_ADDRESS=
# Platform fee in basis points (100 = 1%). Contract maximum is 1000 (10%).
PLATFORM_FEE_BPS=500
# Missions paying more than this per capture (token base units) require Tier 2.
TIER1_MAX_REWARD=5000000
# Time the funder has to reject a submission before anyone can finalize it (seconds).
REVIEW_WINDOW_SECONDS=259200

# Local runs only (anvil): allow deploying to chains other than 46630.
# ALLOW_ANY_CHAIN=true
