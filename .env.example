# ---------------------------------------------------------------------------
# Seenit environment template. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Robinhood Chain ---------------------------------------------------------
# Values from the official docs: https://docs.robinhood.com/chain/connecting
# Testnet chain ID is 46630. The public RPC is rate-limited; use a provider
# RPC (e.g. Alchemy) for anything beyond local testing.
CHAIN_ID=46630
RPC_URL=https://rpc.testnet.chain.robinhood.com
EXPLORER_URL=https://explorer.testnet.chain.robinhood.com

# Reward stablecoin (ERC-20). Take the address from the official Robinhood
# Chain docs for the network you deploy to. Do not guess it.
REWARD_TOKEN_ADDRESS=
REWARD_TOKEN_SYMBOL=USDG
REWARD_TOKEN_DECIMALS=6

# --- Contract deployment (Foundry) -------------------------------------------
# Deployer key: use a throwaway testnet key, or prefer `--account` with a
# Foundry keystore instead of a raw key.
DEPLOYER_PRIVATE_KEY=
# Admin of both contracts (multisig recommended outside testnet).
ADMIN_ADDRESS=
# Backend signer allowed to write personhood attestations.
ATTESTER_ADDRESS=
# Backend signer allowed to record and resolve mission submissions.
VERIFIER_ADDRESS=
# Missions paying more than this per submission (token base units) need Tier 2.
TIER1_MAX_REWARD=5000000

# Filled in after deployment.
MISSION_ESCROW_ADDRESS=
PERSONHOOD_REGISTRY_ADDRESS=
